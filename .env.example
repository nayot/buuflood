# Public URL of the app, including the sub-path (no trailing slash).
PUBLIC_URL=https://eng-ai.buu.ac.th/buuflood
PORT=3000

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, "Web application").
# Authorized redirect URI: ${PUBLIC_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only these email domains may sign in.
ALLOWED_DOMAINS=go.buu.ac.th,eng.buu.ac.th
# Comma-separated; these accounts are always admins.
ADMIN_EMAILS=

# Secrets — generate once and keep them. Losing DATA_KEY makes stored ID/phone numbers unreadable.
#   SESSION_SECRET: openssl rand -hex 32
#   DATA_KEY:       openssl rand -base64 32
SESSION_SECRET=
DATA_KEY=

# Local numbers on the red mental-health panel (1669 and 1323 are always shown). label=number, separated by ;
# Example: EMERGENCY_CONTACTS=ผู้ประสานงานภาคสนาม=08xxxxxxxx;รพ.ท่าใหม่=039xxxxxx
# Changing it needs only a restart (docker compose up -d), not a rebuild.
EMERGENCY_CONTACTS=

# Local development only: enables /auth/dev?email=... (ignored when NODE_ENV=production).
DEV_AUTH=0

# Public URL of the app, including the sub-path (no trailing slash).
PUBLIC_URL=https://eng-ai.buu.ac.th/buuflood
PORT=3000

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, "Web application").
# Authorized redirect URI: ${PUBLIC_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only these email domains may sign in.
ALLOWED_DOMAINS=go.buu.ac.th,eng.buu.ac.th
# New accounts from these domains wait for approval (role "pending") before they can do anything: by an admin, or by
# the manager of an activity they asked to join through its link. `*` = any other Google account, with approval.
# Example: APPROVAL_DOMAINS=gmail.com, or APPROVAL_DOMAINS=*
APPROVAL_DOMAINS=
# Comma-separated; these accounts are always admins.
ADMIN_EMAILS=

# Secrets — generate once and keep them. Losing DATA_KEY makes stored ID/phone numbers unreadable.
#   SESSION_SECRET: openssl rand -hex 32
#   DATA_KEY:       openssl rand -base64 32
SESSION_SECRET=
DATA_KEY=

# Local numbers on the red mental-health panel (1669 and 1323 are always shown). label=number, separated by ;
# Example: EMERGENCY_CONTACTS=ผู้ประสานงานภาคสนาม=08xxxxxxxx;รพ.ท่าใหม่=039xxxxxx
# Changing it needs only a restart (docker compose up -d), not a rebuild.
EMERGENCY_CONTACTS=

# BUU Flood Help LINE Official Account: yellow mental results can be handed over to its chat (all three are needed,
# otherwise the option is hidden). LINE Official Account Manager → Settings → Messaging API; then in LINE Developers
# copy the Channel secret, issue a long-lived Channel access token, and set the webhook URL to
# ${PUBLIC_URL}/line/webhook with "Use webhook" on. In Response settings keep Chat on and turn auto-reply off.
LINE_OA_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Thai ID card scan on the Fixing Centre's walk-in form (hidden unless the key is set). The photo is sent to OpenRouter,
# read by a vision model and dropped; only the name and address come back. Models: first choice, then fallback.
OPENROUTER_API_KEY=
# IDCARD_MODELS=google/gemini-3.5-flash-lite,google/gemini-3.8-flash

# 3.0 upgrade only: on the first start of 3.0 the 2.x database becomes archived activity 1 with this name.
# LEGACY_ACTIVITY_NAME=ลงพื้นที่โขมง 10 ต.ค.

# Local development only: enables /auth/dev?email=... (ignored when NODE_ENV=production).
DEV_AUTH=0
